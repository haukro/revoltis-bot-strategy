# Server-side Supabase settings. Never place the service role key in the React app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
APP_API_TOKEN=change-this-before-public-hosting
REVOLTIS_SYNC_TOKEN=change-this-before-public-hosting
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
