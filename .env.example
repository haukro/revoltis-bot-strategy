# Server-side Supabase settings. Never place the service role key in the React app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
APP_API_TOKEN=change-this-before-public-hosting
REVOLTIS_SYNC_TOKEN=change-this-before-public-hosting
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# SPEC-005 paper-operations secrets. Server-side only; never expose to browser/frontend.
OPS_ADMIN_TOKEN=replace-with-long-random-secret
PAPER_SCHEDULER_TOKEN=replace-with-different-long-random-secret

# Outbox lease duration in seconds. Operational deployment config, not alpha.
PAPER_OUTBOX_LEASE_SECONDS=30
