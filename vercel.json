{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [
        { "source": "/paper-status", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "crons": [
    { "path": "/api/cron/paper/outbox-tick", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/paper/reconcile", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/paper/recover", "schedule": "0 * * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
